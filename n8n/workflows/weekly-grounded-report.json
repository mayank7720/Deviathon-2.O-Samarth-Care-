      "name": "Verify durable report claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const job=$input.first().json;\nif(job.claimed!==true||job.kind!=='weekly_report.request'||typeof job.jobId!=='string'||!/^[A-Za-z0-9_-]{16,96}$/.test(job.jobId)||!job.facts||!job.schema||!/^[a-f0-9]{64}$/.test(job.factsHash)||!['en','hi'].includes(job.language))throw new Error('The server did not durably claim this report job.');\nreturn [{json:job}];"
