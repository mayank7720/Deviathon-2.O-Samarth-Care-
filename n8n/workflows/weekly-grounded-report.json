    {
      "id": "verify-request",
      "name": "Verify request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const input=$input.first().json;\nlet difference=0;\nif(typeof input.computedSignature!=='string'||input.computedSignature.length!==input.signature.length)throw new Error('Invalid integration signature.');\nfor(let i=0;i<input.signature.length;i++)difference|=input.signature.toLowerCase().charCodeAt(i)^input.computedSignature.toLowerCase().charCodeAt(i);\nif(difference)throw new Error('Invalid integration signature.');\nconst envelope=JSON.parse(input.raw);\nif(envelope.version!==1||typeof envelope.jobId!=='string'||!/^[A-Za-z0-9_-]{16,96}$/.test(envelope.jobId))throw new Error('Invalid integration job.');\nreturn [{json:{...input,envelope}}];"
