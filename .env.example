# Placeholder-only template. See docs/QUICKSTART.md before choosing a mode.
# A clean local fixture needs no environment file.
# Native Next.js: copy to .env.local.
# Portable cloud-connected dev: copy to .dev.vars.supabase.
SAMARTH_AUTH_MODE=supabase
SAMARTH_BACKEND=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SAMARTH_PUBLIC_URL=http://127.0.0.1:5173
SAMARTH_ALLOW_SIGNUP=false
SAMARTH_SCHEDULER_CONFIGURED=false

# Optional LLM reports: leave disabled until your workflow and protected
# callback worker share a configured signing credential. Never commit a value.
SAMARTH_N8N_ENABLED=false
SAMARTH_N8N_REPORT_WEBHOOK_URL=
SAMARTH_N8N_HMAC_SECRET=

# Deferred calling: no carrier request or paid fallback is enabled here.
SAMARTH_TWILIO_TRIAL_ENABLED=false
SAMARTH_CALL_BOT_SPOKEN_CHOICES=false
